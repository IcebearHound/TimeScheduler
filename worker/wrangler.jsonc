{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "time-scheduler-auth",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "APP_URL": "https://icebearhound.github.io/TimeScheduler/"
  },
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "CALENDAR_FEEDS", "class_name": "CalendarFeedObject" }] },
  "migrations": [{ "tag": "calendar-v1", "new_sqlite_classes": ["CalendarFeedObject"] }]
}
